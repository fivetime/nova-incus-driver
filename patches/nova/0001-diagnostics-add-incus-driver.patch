From: OpenStack Incus maintainers <openstack-incus@example.invalid>
Subject: [PATCH] diagnostics: Add the Incus driver identifier

The standardized diagnostics response uses a closed enum for the virt
driver. External system-container drivers cannot return truthful diagnostics
because "incus" is not accepted. Add the external driver name to the
diagnostics driver field, response schema and API reference.

Do not add Incus to HVType. HVSpec objects containing that enum cross the RPC
boundary to conductor, which must remain compatible with unmodified Nova.
Incus system containers use the standard LXC execution type for supported
instance reporting.

diff --git a/nova/objects/fields.py b/nova/objects/fields.py
--- a/nova/objects/fields.py
+++ b/nova/objects/fields.py
@@ -850,8 +850,9 @@ class HypervisorDriver(BaseNovaEnum):
     VMWAREAPI = "vmwareapi"
     IRONIC = "ironic"
     HYPERV = "hyperv"
+    INCUS = "incus"
 
-    ALL = (LIBVIRT, XENAPI, VMWAREAPI, IRONIC, HYPERV)
+    ALL = (LIBVIRT, XENAPI, VMWAREAPI, IRONIC, HYPERV, INCUS)
 
 
 class PointerModelType(BaseNovaEnum):
diff --git a/nova/api/openstack/compute/schemas/server_diagnostics.py b/nova/api/openstack/compute/schemas/server_diagnostics.py
--- a/nova/api/openstack/compute/schemas/server_diagnostics.py
+++ b/nova/api/openstack/compute/schemas/server_diagnostics.py
@@ -74,6 +74,7 @@ index_response_v248 = {
                 'libvirt',
                 'vmwareapi',
                 'xenapi',
+                'incus',
             ],
         },
         'hypervisor': {'type': ['string', 'null']},
diff --git a/api-ref/source/parameters.yaml b/api-ref/source/parameters.yaml
--- a/api-ref/source/parameters.yaml
+++ b/api-ref/source/parameters.yaml
@@ -2475,6 +2475,7 @@ driver_diagnostics:
     - ``xenapi``
     - ``vmwareapi``
     - ``ironic``
+    - ``incus``
   in: body
   required: true
   type: string
