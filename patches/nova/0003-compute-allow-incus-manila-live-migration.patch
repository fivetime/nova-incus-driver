+def _provider_supports_trait(context, provider_uuid, capability_trait):
+    trait_info = report.report_client_singleton().get_provider_traits(
+        context, provider_uuid)
+    return capability_trait in trait_info.traits
+
+
+def _require_share_migration_capability(
+        context, instance, capability_trait):
+    """Require source support and return the target scheduling trait."""
+    if not instance_has_share(context, instance):
+        return None
+
+    node = objects.ComputeNode.get_by_host_and_nodename(
+        context, instance.host, instance.node)
+    if not _provider_supports_trait(
+            context, node.uuid, capability_trait):
+        raise exception.ForbiddenWithShare()
+
+    return capability_trait
+
+
