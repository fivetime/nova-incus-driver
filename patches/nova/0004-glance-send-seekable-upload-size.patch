diff --git a/nova/image/glance.py b/nova/image/glance.py
index 7804e6a3bd..433d603b50 100644
--- a/nova/image/glance.py
+++ b/nova/image/glance.py
@@ -579,10 +579,22 @@ class GlanceImageServiceV2(object):
             _reraise_translated_exception()
 
     def _upload_data(self, context, image_id, data):
+        image_size = None
+        try:
+            image_size = os.fstat(data.fileno()).st_size - data.tell()
+        except (AttributeError, OSError, TypeError, ValueError):
+            # Preserve support for generators and other non-seekable streams.
+            pass
+
         # NOTE(aarents) In eventlet mode offload upload in a native thread as
         # it can block coroutine in busy environment.
-        utils.tpool_wrap(
-            self._client.call)(context, 2, 'upload', args=(image_id, data))
+        upload = utils.tpool_wrap(self._client.call)
+        if image_size is None:
+            upload(context, 2, 'upload', args=(image_id, data))
+        else:
+            upload(
+                context, 2, 'upload', args=(image_id, data),
+                kwargs={'image_size': image_size})
 
         return self._client.call(context, 2, 'get', args=(image_id,))
 
