+    def test_get_sdk_adapter_user_token_uses_oslo_conf(
+            self, mock_load_auth, mock_token_auth, mock_load_session):
+        ctxt = mock.Mock(
+            auth_token=mock.sentinel.token,
+            project_id=mock.sentinel.project_id,
+            project_domain_id=mock.sentinel.project_domain_id,
