@@ -1151,6 +1151,33 @@ class TestGetSDKAdapter(test.NoDBTestCase):
             exception.ServiceUnavailable,
             self._test_get_sdk_adapter, True, strict=True)
 
+    @mock.patch('nova.utils.ks_loading.load_auth_from_conf_options')
+    def test_get_sdk_adapter_user_token_uses_oslo_conf(self, mock_load_auth):
+        ctxt = mock.Mock(
+            auth_token=mock.sentinel.token,
+            project_id=mock.sentinel.project_id,
+            project_domain_id=mock.sentinel.project_domain_id,
+        )
+
+        self.assertEqual(
+            mock.sentinel.proxy,
+            utils.get_sdk_adapter(
+                self.service_type, admin=False, context=ctxt))
+
+        self.mock_get_confgrp.assert_called_once_with(self.service_type)
+        self.mock_get_auth_sess.assert_not_called()
+        mock_load_auth.assert_called_once_with(
+            self.mock_conf, 'service_user')
+        self.mock_connection.assert_called_once_with(
+            token=mock.sentinel.token,
+            auth_type='v3token',
+            project_id=mock.sentinel.project_id,
+            project_domain_id=mock.sentinel.project_domain_id,
+            auth_url=self.mock_conf.service_user.auth_url,
+            oslo_conf=self.mock_conf,
+            service_types={'test_service'},
+            strict_proxies=False)
+
     def test_get_sdk_adapter_conf_group_fail(self):
         self.mock_get_confgrp.side_effect = (
             exception.ConfGroupForServiceTypeNotFound(stype=self.service_type))
