# nova-rootwrap filters for compute nodes running nova-incus
# This file should be owned by (and only-writable by) the root user
#
# Mount/umount/chown moved to dedicated privsep entrypoints
# (nova/virt/incus/privsep.py) with path validation; only the read-only
# storage reporting binaries remain here.

[Filters]
zfs: CommandFilter, zfs, root
zpool: CommandFilter, zpool, root
btrfs: CommandFilter, btrfs, root
