[Unit]
Description=OpenStack Incus live migration attachment cardinality matrix
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/openstack-incus/live-migration-cardinality-matrix.env
WorkingDirectory=/opt/stack/openstack-incus
ExecStart=/bin/bash -lc 'source /opt/stack/devstack/openrc admin admin >/dev/null; exec /bin/bash ./tools/openstack-incus-live-migration-cardinality-matrix.sh'
TimeoutStartSec=infinity
