#
# Emit every Incus container root image in the audited RBD pool as a JSON
# list, for tools/openstack-incus-scale-e2e.py --rbd-inventory-command.
#
# Only container roots are reported. The image cache (image_*, carrying the
# per-node ceph.rbd.image_prefix) and the pool's own marker objects are not
# instance state and the scale runner rejects them by design.
#
# Environment:
#   INCUS_RBD_POOL  root pool name (default incus-rootfs-rbd-pool)
#   INCUS_RBD_ID    Ceph client id  (default incus)
set -euo pipefail

pool=${INCUS_RBD_POOL:-incus-rootfs-rbd-pool}
ceph_id=${INCUS_RBD_ID:-incus}

rbd --id "$ceph_id" -p "$pool" ls --format json |
    jq -c '[.[] | select(startswith("container_") or
                         startswith("zombie_container_"))]'
