#
# Emit every OVN logical switch port name as a JSON list, for
# tools/openstack-incus-scale-e2e.py --ovn-lsp-inventory-command.
#
# The runner compares this against the ports it created, so a leaked LSP
# after cleanup is what this exists to catch.
#
# Environment:
#   OVN_NB_DB  northbound database connection (default from ovn-nbctl)
set -euo pipefail

if [[ -n ${OVN_NB_DB:-} ]]; then
    set -- --db="$OVN_NB_DB"
else
    set --
fi

ovn-nbctl "$@" --format=json --columns=name list Logical_Switch_Port |
    jq -c '[.data[][] | select(type == "string" and . != "")]'
