"""Production fence-provider adapter for standard ClusterLabs fence agents."""

import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
STATUS_RE = re.compile(r"(?:status\s*:\s*)?\b(on|off)\b", re.IGNORECASE)
MAX_SECURE_FILE_SIZE = 64 * 1024
COMMON_KEYS = {
    "agent",
    # Optional: the Nova compute node UUID of the machine this entry
    # fences. It is never passed to the fence agent; it exists so that
    # tools acting on a fenced host can prove the compute they are about
    # to act on is the one whose power they just checked. A powered-off
    # host cannot be asked for its own UUID, so it has to be recorded
    # here in advance.
    "compute_id",
    "ip",
    "ipport",
    "username",
    "password_file",
    "plug",
    "power_timeout",
}
AGENTS = {
    "ipmilan": {
        "binary": "fence_ipmilan",
        "keys": COMMON_KEYS | {"auth", "cipher", "lanplus", "privlvl"},
        "required": {"ip", "username", "password_file"},
        "defaults": {"lanplus": True, "method": "onoff"},
    },
    "redfish": {
        "binary": "fence_redfish",
        "keys": COMMON_KEYS
        | {"redfish_uri", "systems_uri", "ssl_insecure"},
        "required": {"ip", "username", "password_file"},
        "defaults": {"ssl_insecure": False},
    },
    "virsh": {
        "binary": "fence_virsh",
        "keys": {
            "agent",
            "identity_file",
            "ip",
            "ipport",
            "plug",
            "power_timeout",
            "username",
        },
        "required": {"identity_file", "ip", "plug", "username"},
        "defaults": {"ssh": True},
    },
}


class ProviderError(RuntimeError):
    pass


def _read_secure_file(path, description):
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise ProviderError(
            f"cannot open {description} {path}: {exc}"
        ) from exc
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            raise ProviderError(
                f"{description} must be a regular file: {path}"
            )
        if info.st_uid != 0:
            raise ProviderError(f"{description} must be owned by root: {path}")
        if stat.S_IMODE(info.st_mode) & 0o077:
            raise ProviderError(
                f"{description} must not be accessible by group/other: {path}"
            )
        if info.st_size > MAX_SECURE_FILE_SIZE:
            raise ProviderError(f"{description} exceeds 64 KiB: {path}")
        content = bytearray()
        while len(content) <= MAX_SECURE_FILE_SIZE:
            chunk = os.read(descriptor, 8192)
            if not chunk:
                break
            content.extend(chunk)
        if len(content) > MAX_SECURE_FILE_SIZE:
            raise ProviderError(f"{description} exceeds 64 KiB: {path}")
        return content.decode("utf-8")
    except (OSError, UnicodeError) as exc:
        raise ProviderError(
            f"cannot read {description} {path}: {exc}"
        ) from exc
    finally:
        os.close(descriptor)


def _scalar(value, key):
    if isinstance(value, bool):
        return "1" if value else "0"
    if isinstance(value, int) and not isinstance(value, bool):
        if value <= 0:
            raise ProviderError(f"{key} must be greater than zero")
        return str(value)
    if (
        isinstance(value, str)
        and value
        and "\n" not in value
        and "\r" not in value
    ):
        return value
    raise ProviderError(f"{key} must be a non-empty scalar without newlines")


def load_config(config_dir, fence_id):
    if not ID_RE.fullmatch(fence_id):
        raise ProviderError("invalid fence ID")

    path = config_dir / f"{fence_id}.json"
    try:
        config = json.loads(_read_secure_file(path, "fence configuration"))
    except json.JSONDecodeError as exc:
        raise ProviderError(
            f"invalid JSON in fence configuration {path}: {exc}"
        ) from exc
    if not isinstance(config, dict):
        raise ProviderError("fence configuration must be a JSON object")

    agent_name = config.get("agent")
    if agent_name not in AGENTS:
        raise ProviderError(f"unsupported fence agent: {agent_name!r}")
    unknown = set(config) - AGENTS[agent_name]["keys"]
    if unknown:
        keys = ", ".join(sorted(unknown))
        raise ProviderError(f"unsupported configuration keys: {keys}")
    for required in AGENTS[agent_name]["required"]:
        if required not in config:
            raise ProviderError(
                f"missing required configuration key: {required}"
            )

    parameters = dict(AGENTS[agent_name]["defaults"])
    for key, value in config.items():
        if key not in {"agent", "password_file", "compute_id"}:
            parameters[key] = value

    if "password_file" in config:
        password_path = Path(
            _scalar(config["password_file"], "password_file")
        )
        if not password_path.is_absolute():
            raise ProviderError("password_file must be an absolute path")
        password = _read_secure_file(password_path, "fence password file")
        password = password.rstrip("\r\n")
        if not password or "\n" in password or "\r" in password:
            raise ProviderError("fence password must be one non-empty line")
        parameters["password"] = password

    if "identity_file" in config:
        identity_path = Path(
            _scalar(config["identity_file"], "identity_file")
        )
        if not identity_path.is_absolute():
            raise ProviderError("identity_file must be an absolute path")
        _read_secure_file(identity_path, "fence SSH identity")

    return AGENTS[agent_name]["binary"], parameters


def invoke(binary, parameters, action, agent_dir):
    executable = agent_dir / binary
    if not executable.is_file() or not os.access(executable, os.X_OK):
        raise ProviderError(f"fence agent is not executable: {executable}")

    lines = [f"action={action}"]
    lines.extend(
        f"{key}={_scalar(value, key)}"
        for key, value in parameters.items()
    )
    payload = "\n".join(lines) + "\n"
    try:
        result = subprocess.run(
            [str(executable)],
            input=payload,
            text=True,
            capture_output=True,
            timeout=180,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ProviderError(f"fence agent execution failed: {exc}") from exc
    status_off = action == "status" and result.returncode == 2
    if result.returncode != 0 and not status_off:
        detail = (
            result.stderr.strip()
            or result.stdout.strip()
            or "no diagnostic"
        )
        password = parameters.get("password")
        if password:
            detail = detail.replace(str(password), "[REDACTED]")
        raise ProviderError(
            f"fence agent returned {result.returncode}: {detail}"
        )
    return result.stdout, result.returncode


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("off", "on", "status"))
    parser.add_argument("fence_id")
    parser.add_argument(
        "--config-dir",
        type=Path,
        default=Path("/etc/openstack-incus/fence.d"),
    )
    parser.add_argument(
        "--agent-dir",
        type=Path,
        default=Path("/usr/sbin"),
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args(argv)

    try:
        binary, parameters = load_config(args.config_dir, args.fence_id)
        output, returncode = invoke(
            binary,
            parameters,
            args.action,
            args.agent_dir,
        )
        if args.action == "status":
            states = {match.lower() for match in STATUS_RE.findall(output)}
            if len(states) != 1:
                raise ProviderError(
                    "fence agent did not return an unambiguous power state"
                )
            state = states.pop()
            expected = "on" if returncode == 0 else "off"
            if state != expected:
                raise ProviderError(
                    "fence agent status output contradicts its return code"
                )
            print(state)
    except ProviderError as exc:
        print(f"fence provider: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
